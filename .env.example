# ============================================================
# RetailPulse — variables d'environnement
# Copier ce fichier vers .env et adapter les valeurs.
# NE JAMAIS committer .env (mot de passe PostgreSQL).
# ============================================================

# --- Kafka (mode KRaft, sans ZooKeeper) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_PRODUCTS=retail-products
KAFKA_TOPIC_CUSTOMERS=retail-customers
KAFKA_TOPIC_ORDERS=retail-orders
KAFKA_TOPIC_ORDER_EVENTS=retail-order-events
KAFKA_TOPIC_DLQ=retail-events-dlq
KAFKA_NUM_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=retailpulse
POSTGRES_USER=retail
POSTGRES_PASSWORD=change-me-in-prod

# --- API DummyJSON ---
DUMMYJSON_BASE_URL=https://dummyjson.com
DUMMYJSON_TIMEOUT_SECONDS=30

# --- Producteur (simulation) ---
PRODUCER_MIN_INTERVAL_MS=500
PRODUCER_MAX_INTERVAL_MS=2000
PRODUCER_PAYMENT_COMPLETED_RATE=0.85
PRODUCER_PAYMENT_FAILED_RATE=0.10
# Le reste (5% par défaut) correspond à ORDER_CANCELLED.
# Taux d'injection de doublons pour démontrer la déduplication (0.0 = aucun doublon)
PRODUCER_DUPLICATE_RATE=0.0
PRODUCER_MAX_ITEMS_PER_ORDER=4

# --- Spark Structured Streaming ---
SPARK_WATERMARK_DELAY=10 minutes
SPARK_WINDOW_DURATION=5 minutes
SPARK_TRIGGER_INTERVAL=10 seconds
SPARK_CHECKPOINT_DIR=/opt/spark/checkpoint

# --- Dashboard ---
DASHBOARD_REFRESH_SECONDS=10